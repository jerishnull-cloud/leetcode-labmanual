class MyHashSet {
    private static final int BUCKET_COUNT = 1000;
    private LinkedList<Integer>[] buckets;

    public MyHashSet() {
        buckets = new LinkedList[BUCKET_COUNT];
        for (int i = 0; i < BUCKET_COUNT; i++) {
            buckets[i] = new LinkedList<>();
        }
    }
    
    private int hash(int key) {
        return key % BUCKET_COUNT;
    }
    
    public void add(int key) {
        int bucketIndex = hash(key);
        if (!buckets[bucketIndex].contains(key)) {
            buckets[bucketIndex].add(key);
        }
    }
    
    public void remove(int key) {
        int bucketIndex = hash(key);
        buckets[bucketIndex].remove(Integer.valueOf(key)); // remove by object, not index
    }
    
    public boolean contains(int key) {
        int bucketIndex = hash(key);
        return buckets[bucketIndex].contains(key);
    }
}

